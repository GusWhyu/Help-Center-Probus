# ========================================================
# PROBUS HELP CENTER - FRONTEND ENVIRONMENT VARIABLES
# ========================================================

# 1. Base URL API Help Center (Go Server atau Laravel API)
# - Lokal: http://localhost:8088/api/v1 (atau biarkan kosong untuk default)
# - Live/Production: https://api.namadomain.com/api/v1 atau http://IP_SERVER:8088/api/v1
VITE_API_URL=http://localhost:8088/api/v1

# 2. Base URL Storage / Uploads (Server tempat file logo & media diupload - Project Implementator)
# - Lokal: http://127.0.0.1:8000
# - Live/Production: https://probus.probussystem.com
# - Jika variabel ini kosong di frontend, sistem otomatis mendeteksi:
#   * Saat akses di localhost/127.0.0.1 -> otomatis mengarah ke http://127.0.0.1:8000
#   * Saat akses di live (help-center.probussystem.com) -> otomatis mengarah ke https://probus.probussystem.com
VITE_STORAGE_URL=http://127.0.0.1:8000
