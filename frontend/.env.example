# ========================================================
# PROBUS HELP CENTER - FRONTEND ENVIRONMENT VARIABLES
# ========================================================

# 1. Base URL API Help Center (Go Server atau Laravel API)
# - Lokal: http://localhost:8088/api/v1 (atau biarkan kosong untuk default)
# - Live/Production: https://api.namadomain.com/api/v1 atau http://IP_SERVER:8088/api/v1
VITE_API_URL=http://localhost:8088/api/v1

# 2. Base URL Storage / Uploads (Server tempat file logo & media diupload)
# - Jika Help Center dan Laravel Admin berada di domain berbeda di server live:
#   Setel variabel ini ke domain Laravel Admin, contoh: https://admin.probussystem.com
# - Jika menggunakan reverse proxy Nginx pada domain yang sama (/uploads):
#   Biarkan kosong atau arahkan ke domain utama Help Center.
VITE_STORAGE_URL=
