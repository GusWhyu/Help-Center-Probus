# App Configuration
APP_NAME=Layrd
APP_ENV=development
APP_PORT=8088
PORT=8088
SERVER_PORT=8088
GIN_MODE=debug
API_PREFIX=/api/v1
STORAGE_PATH=./storage/uploads
STORAGE_URL=/storage

# Security & Auth
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://help-center.probussystem.com,https://probus.probussystem.com
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Primary Database (Default)
# Supported drivers: postgres, mysql
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=layrd_main
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5

# Secondary Database (Example: Tenant/User DB)
# Optional overrides; blank values inherit from DB_DRIVER and primary settings.
DB_USER_DRIVER=
DB_USER_HOST=127.0.0.1
DB_USER_PORT=
DB_USER_USER=
DB_USER_PASSWORD=
DB_USER_NAME=
DB_USER_SSLMODE=disable

# Frontend Configuration (Vite & Vue)
# - VITE_API_URL: Base URL API Help Center (Go Server)
# - VITE_STORAGE_URL: Base URL Server Uploads / Media (Project Implementator Laravel)
#   * Lokal: http://127.0.0.1:8000
#   * Live: https://probus.probussystem.com
VITE_API_URL=http://localhost:8088/api/v1
VITE_STORAGE_URL=http://127.0.0.1:8000
