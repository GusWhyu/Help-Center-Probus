# App Configuration
APP_NAME=Layrd
APP_ENV=development
APP_PORT=8080
GIN_MODE=debug
API_PREFIX=/api/v1
STORAGE_PATH=./storage/uploads
STORAGE_URL=/storage

# Security & Auth
JWT_SECRET=supersecretjwtkeychangeinproduction_1234567890
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Primary Database (Default)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=layrd_main
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5

# Secondary Database (Example: Tenant/User DB)
DB_USER_HOST=127.0.0.1
DB_USER_PORT=5432
DB_USER_USER=postgres
DB_USER_PASSWORD=postgres
DB_USER_NAME=barong_user
DB_USER_SSLMODE=disable
